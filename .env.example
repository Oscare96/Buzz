# Buzz secrets and local configuration.
# Copy this file to .env. Never commit real secrets.

OPENAI_API_KEY=
BUZZ_OPENAI_MODEL=gpt-5.6
BUZZ_STT_MODEL=gpt-4o-transcribe

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Local openWakeWord model path. Example: models/hey_buzz.tflite
BUZZ_WAKE_MODEL=

# Files Buzz may read/write/delete through filesystem skills stay under this root.
BUZZ_WORKSPACE=~/BuzzWorkspace

# Optional Home Assistant integration. Leave blank to keep home skills disabled.
HOME_ASSISTANT_URL=
HOME_ASSISTANT_TOKEN=

# Optional GitHub DevOps integration. Use a least-privilege token.
BUZZ_GITHUB_TOKEN=

# Optional Alpaca integration. Paper trading is the default endpoint.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
